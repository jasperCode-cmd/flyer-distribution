# PostgreSQL connection string used by Prisma (via the pg driver adapter).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth.js (NextAuth) session encryption secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-generated-secret"

# Required for Auth.js v5 when running in production mode (next start) on a
# host it doesn't auto-detect (Vercel deployments auto-detect this and don't
# need it set, but it's safe to leave in either way).
AUTH_TRUST_HOST="true"

# Gmail sending for the CRM. One shared mailbox (flyerdistributionhampshire@gmail.com)
# used for every CRM user, authorised with Google OAuth (not SMTP). The
# refresh token is produced once by running scripts/gmail-authorise.mjs
# locally, never by hand. If any of the first four are missing, the CRM
# shows a "Gmail is not connected" state instead of the send form.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_ADDRESS=""
# Optional. Comma separated addresses to exclude from the conversation view
# (for example an internal distribution list that also lands in this inbox).
GMAIL_EXCLUDE_ADDRESSES=""
