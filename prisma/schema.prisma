generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Only "admin" is used today. Plain string (not an enum) so a future
// role like "guest" can be introduced without a schema migration.
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  // Short login handle, used instead of email to sign in. Nullable so the
  // column could be added to a table that already had rows; every real
  // account is expected to have one, and a row without one cannot log in.
  username           String?  @unique
  passwordHash       String
  name               String
  role               String   @default("admin")
  // Forces a password change (enforced server-side via middleware) before
  // the account can use the rest of the CRM. True for newly seeded users.
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  assignedLeads      Lead[]              @relation("AssignedLeads")
  activities         Activity[]
  savedFilterViews   SavedFilterView[]
  calendarEvents     CalendarEvent[]
  expenses           Expense[]
  priorityDismissals PriorityDismissal[]
}

enum LeadSource {
  WEBSITE_QUOTE_FORM
  INSTAGRAM_DM
  REFERRAL
  COLD_OUTREACH
  // Gathered face-to-face: canvassing, events, trade shows. Distinct from
  // a scraped cold-outreach list and from a referral.
  MET_IN_PERSON
  OTHER
}

enum PipelineStage {
  UNCONTACTED
  AWAITING_RESPONSE
  WON
  COMPLETED
  LOST
}

enum LostReason {
  PRICE
  CHOSE_COMPETITOR
  WENT_QUIET
  NOT_READY
  OTHER
}

enum LeadPriority {
  HIGH
  MEDIUM
  LOW
}

enum ScrapReason {
  NOT_INTERESTED
  WRONG_NUMBER
  ALREADY_CUSTOMER
  ASKED_NOT_TO_CONTACT
  NO_ANSWER
  OTHER
}

// Both of the below are only meaningful once a lead is Won or Completed, but
// they carry a default on every lead so the columns can be NOT NULL and no
// row needs special handling.
enum ReviewStatus {
  NOT_REQUESTED
  REQUESTED
  RECEIVED
}

enum PaymentStatus {
  NOT_PAID
  DEPOSIT_PAID
  PARTIAL_PAID
  PAID_IN_FULL
}

// Which business a lead belongs to: Flyer Distribution Hampshire, or
// Leaflet Distribution Bournemouth, whose leads arrive through their own
// intake and are emailed from their own address. Every lead from before
// this existed is FDH.
enum Business {
  FDH
  LDB
}

model Lead {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  email        String?
  // Required going forward for leads entered manually in the CRM. Nullable
  // here because leads auto-captured from the public /quote form have no
  // postcode field to source it from (removed from that form deliberately;
  // see project notes); enforced as required in the manual Add Lead form
  // instead of at the database level.
  postcode     String?
  businessName String?
  addressArea  String?
  business     Business @default(FDH)

  dealValue        Decimal? @db.Decimal(10, 2)
  leafletQuantity  String?
  targetAreas      String?
  printingIncluded Boolean  @default(false)
  designIncluded   Boolean  @default(false)

  source   LeadSource    @default(OTHER)
  stage    PipelineStage @default(UNCONTACTED)
  priority LeadPriority  @default(MEDIUM)
  // Usable within "Awaiting Response" for a stalled/hesitant lead.
  atRisk   Boolean       @default(false)

  // Prompted for when a lead is moved to the Lost stage. lostReasonNote
  // carries the free text when lostReason is OTHER.
  lostReason     LostReason?
  lostReasonNote String?

  // Surfaced on the Won and Completed stages. amountPaid mirrors dealValue's
  // precision so the two can be compared without rounding surprises; it
  // stays nullable because a lead with no quoted value has nothing to
  // auto-fill from.
  reviewStatus  ReviewStatus  @default(NOT_REQUESTED)
  paymentStatus PaymentStatus @default(NOT_PAID)
  amountPaid    Decimal?      @db.Decimal(10, 2)

  // When the lead was won, which decides the month its profit counts
  // towards. Set through the one shared stage-change function whenever the
  // lead moves into Won, whatever moved it; leaving Won never clears it and
  // moving on to Completed keeps it. Null for leads won before this existed
  // until backfilled from their stage history or set by hand.
  wonAt DateTime?

  // A retainer: a monthly amount that counts as revenue in every month from
  // retainerStart to retainerEnd (both calendar months, stored as the 1st of
  // the month; no end means it carries on). Any one-off deal value or amount
  // paid on the same lead still counts in its won month as before.
  isRetainer           Boolean   @default(false)
  retainerMonthlyPence Int?
  retainerStart        DateTime? @db.Date
  retainerEnd          DateTime? @db.Date

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])

  // Dialer fields. noAnswerStreak counts consecutive no-answer outcomes and
  // resets to 0 the moment a call is actually answered; nextCallableAt is
  // when the lead becomes eligible for the dialer's active queue again;
  // null means never called, immediately eligible. assignedTo (above) is
  // reused as the dialer's callback-locking mechanism: it's set to the
  // calling user only on a Call Back outcome, so a lead someone was asked
  // to specifically follow up on doesn't surface for the other user.
  noAnswerStreak Int       @default(0)
  nextCallableAt DateTime?

  // Leads scrapped from the dialer (or elsewhere) never show in the Kanban
  // board, main Leads list, filters, or search, only in the Scrapped
  // Leads bin. scrapNote is only populated when scrapReason is OTHER.
  scrapped    Boolean      @default(false)
  scrapReason ScrapReason?
  scrapNote   String?
  scrappedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities     Activity[]
  job            Job?
  tasks          Task[]
  tags           LeadTag[]
  calendarEvents CalendarEvent[]
  costs          JobCost[]
  quotes         Quote[]
  invoices       Invoice[]

  @@index([stage])
  @@index([assignedToId])
  @@index([priority])
  @@index([scrapped])
  @@index([nextCallableAt])
  @@index([wonAt])
  @@index([business])
}

enum ActivityType {
  CALL
  EMAIL
  NOTE
  STAGE_CHANGE
}

// "Last interacted" is derived at query time (most recent Activity per
// Lead), not stored as a redundant column.
model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  detail    String
  createdAt DateTime     @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt])
}

// Follow-up tasks for a lead, separate from the auto-detected "stale lead"
// signal (which is based on last Activity, not a scheduled follow-up).
enum PriorityLevel {
  URGENT
  HIGH
  NORMAL
  LOW
}

model Task {
  id          String        @id @default(cuid())
  description String
  dueDate     DateTime
  completed   Boolean       @default(false)
  // Where the task sits on the Priorities list.
  priority    PriorityLevel @default(NORMAL)
  createdAt   DateTime      @default(now())

  // Optional, so a task added on the Priorities page needn't be about a lead.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([dueDate])
}

// Done and Snooze on the Priorities list. itemKey is the item's type and the
// record it is about (for example "awaiting:<lead id>" or "task:<task id>").
// fingerprint is the state that raised the item when it was dismissed: Done
// holds only while the item's current fingerprint still matches, so a new
// email or a changed payment status brings it back. snoozedUntil hides it
// until then. One row per item; acting again replaces it.
model PriorityDismissal {
  id           String    @id @default(cuid())
  itemKey      String    @unique
  fingerprint  String
  snoozedUntil DateTime?
  dismissed    Boolean   @default(false)
  note         String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#2563eb")

  leads LeadTag[]
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

// A user's saved combination of table/Kanban filters, for quick re-selection.
// Kept as a JSON blob rather than individual columns so new filter fields
// (e.g. tags added later) don't require a schema change here.
model SavedFilterView {
  id      String @id @default(cuid())
  name    String
  filters Json

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum JobStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Job {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  printStatus     WorkStatus   @default(NOT_STARTED)
  designStatus    WorkStatus   @default(NOT_STARTED)
  // Plain text for now; structured so a real Distributor table could
  // reference it later without reshaping this field.
  distributorName String?
  // Structured link to a real Distributor. Deliberately kept alongside
  // distributorName rather than replacing it; existing free-text values
  // are NOT auto-matched to Distributor rows; that stays a manual step.
  distributorId   String?
  distributor     Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  campaignStartDate DateTime?
  completionDate    DateTime?

  // Nullable foundation for a future real map integration, not populated
  // or read by any external mapping API today.
  latitude  Float?
  longitude Float?

  // Matches the business's actual current tracking method (Strava route
  // screenshots), not GPS hardware, which isn't live yet.
  deliveryConfirmed Boolean @default(false)
  deliveryProofNote String?

  status JobStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEvents CalendarEvent[]

  @@index([distributorId])
}

// A person or subcontractor who delivers leaflets. Deactivated via the
// active flag rather than deleted, so past Jobs and CalendarEvents keep
// pointing at a real row.
model Distributor {
  id     String  @id @default(cuid())
  name   String
  phone  String?
  email  String?
  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs           Job[]
  calendarEvents CalendarEvent[]
  applications   DistributorApplication[]
  costs          JobCost[]

  @@index([active])
}

enum JobCostCategory {
  DISTRIBUTOR
  FUEL
  PRINTING
  DESIGN
  ADDITIONAL
}

enum DistributorPayType {
  FLAT
  PER_THOUSAND
}

// One cost line against a won job, for the Profit calculator. Attached to the
// Lead rather than its Job: revenue (deal value, amount paid) and wonAt live
// on the Lead, the Profit page reads leads directly, and a lead that leaves
// Won or Completed keeps its cost lines. All money here is integer pence;
// the Lead's existing Decimal pounds fields are unchanged.
model JobCost {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  category JobCostCategory

  // Who was paid, for distributor (and fuel) lines. Deleting a distributor
  // keeps the cost line, just without the link.
  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  // Distributor lines only. PER_THOUSAND lines keep the rate and leaflet
  // count they were worked out from.
  payType      DistributorPayType?
  ratePence    Int?
  leafletCount Int?

  // The line's final amount. For PER_THOUSAND it is always worked out on the
  // server from ratePence and leafletCount, never taken from the browser.
  amountPence Int

  // Required for ADDITIONAL lines (checked by the API).
  label String?
  note  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([distributorId])
}

enum ExpenseCategory {
  OFFICE
  SOFTWARE
  VEHICLE
  MARKETING
  EQUIPMENT
  OTHER
}

enum ExpenseKind {
  ONE_OFF
  MONTHLY
}

// Which business an expense is for: one of the two, or both. Every expense
// from before this existed is shared.
enum ExpenseBusiness {
  FDH
  LDB
  SHARED
}

// A business-wide cost, not tied to any job. A one-off has a date (a UK
// calendar day). A monthly one runs from startMonth to endMonth (both stored
// as the 1st of the month); no endMonth means it carries on every month.
// Ending a monthly expense sets endMonth, so its past months stay counted.
model Expense {
  id          String          @id @default(cuid())
  label       String
  category    ExpenseCategory
  amountPence Int
  kind        ExpenseKind
  date        DateTime?       @db.Date
  startMonth  DateTime?       @db.Date
  endMonth    DateTime?       @db.Date
  note        String?
  business    ExpenseBusiness @default(SHARED)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([startMonth])
}

enum DistributorApplicationStatus {
  NEW
  CONTACTED
  APPROVED
  NOT_SUITABLE
}

enum DistributorApplicationSource {
  WEBSITE_FORM
  GMAIL_IMPORT
}

// An application from the website's Work With Us form, or one imported from
// a past Web3Forms notification email. Nothing becomes a Distributor
// automatically: approving an application creates one and links it here.
// Only the applicant's name is required, because an imported email may be
// missing a field; the website form itself still requires its usual fields.
model DistributorApplication {
  id           String   @id @default(cuid())
  fullName     String
  phone        String?
  email        String?
  // "Where do you live?", as given.
  area         String?
  // Stored exactly as given, never parsed into a number.
  age          String?
  // Null when an imported email didn't say.
  hasCar       Boolean?
  hasLicence   Boolean?
  availability String?

  status DistributorApplicationStatus @default(NEW)
  notes  String?
  source DistributorApplicationSource

  // Which business's website it came through: FDH's Work With Us form (and
  // the Gmail import), or Leaflet Distribution Bournemouth's. Every
  // application from before this existed is FDH. Approved applicants become
  // distributors shared by both businesses.
  business Business @default(FDH)

  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  // Imported applications only; unique so the same email never imports twice.
  gmailMessageId String? @unique

  // When the application was made: submission time, or the email's date.
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([receivedAt])
  @@index([phone])
  @@index([distributorId])
}

enum CalendarEventType {
  CALL
  COLD_CALL_BLOCK
  DISTRIBUTOR_SHIFT
  GENERAL
}

// Manually created calendar entries. Job dates and Task due dates are
// surfaced on the calendar too, but are read from their own models at
// query time rather than duplicated as rows here.
model CalendarEvent {
  id            String            @id @default(cuid())
  type          CalendarEventType
  title         String
  startDateTime DateTime
  // Null for a point-in-time entry; set for a multi-hour or multi-day one.
  endDateTime   DateTime?
  notes         String?
  completed     Boolean           @default(false)

  // All four links are optional and set null on delete, so removing a
  // lead, job, user, or distributor never silently deletes a calendar
  // entry someone scheduled.
  linkedLeadId String?
  linkedLead   Lead?   @relation(fields: [linkedLeadId], references: [id], onDelete: SetNull)

  linkedJobId String?
  linkedJob   Job?    @relation(fields: [linkedJobId], references: [id], onDelete: SetNull)

  assignedToUserId String?
  assignedToUser   User?   @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // Only meaningful for DISTRIBUTOR_SHIFT entries.
  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDateTime])
  @@index([type])
  @@index([assignedToUserId])
  @@index([distributorId])
  @@index([linkedLeadId])
  @@index([linkedJobId])
}

// --- Quotes and invoices ------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum InvoiceType {
  // 50% of the campaign total, due on receipt, to book the campaign.
  DEPOSIT
  // The campaign total less the paid deposits it deducts.
  BALANCE
  // The whole campaign total, for a job with no deposit.
  FULL
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  // A sent invoice is voided rather than deleted, so its number stays used.
  VOID
}

// The two numbering sequences: invoices (INV-) and quotes (QUO-), each
// shared by both businesses.
enum DocumentSequence {
  INVOICE
  QUOTE
}

// The next number to hand out in each sequence. A number is taken by
// incrementing the row inside the transaction that saves the document, so
// two people can never get the same one, and nothing ever decrements it, so
// a number is never reused, even when a draft is deleted. Seeded by its
// migration so the next invoice is INV-1106 and the next quote QUO-1001.
model DocumentCounter {
  sequence DocumentSequence @id
  next     Int
}

// A quote for a lead. The business, and the client details printed on it,
// are copied from the lead when it is created and edited on the quote, so a
// later change to the lead never alters a document already issued. All
// money is integer pence; there is no VAT anywhere. Dates are UK calendar
// days. A lead with quotes or invoices can't be deleted (Restrict).
model Quote {
  id     String @id @default(cuid())
  // "QUO-1001", from the QUOTE sequence.
  number String @unique

  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  business Business

  status     QuoteStatus @default(DRAFT)
  issueDate  DateTime    @db.Date
  validUntil DateTime    @db.Date

  // The client as printed on the quote.
  clientName         String
  clientBusinessName String?
  clientEmail        String?
  // The lead's address, or its area when there is no address.
  clientAddress      String?
  targetAreas        String?

  // The sum of the lines, worked out on the server.
  totalPence Int
  notes      String?

  sentAt     DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    QuoteLine[]
  invoices Invoice[]

  @@index([leadId])
  @@index([status])
}

model QuoteLine {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  label       String
  // The leaflet quantity, where the line has one.
  quantity    Int?
  amountPence Int
  sortOrder   Int

  @@index([quoteId])
}

// An invoice for a lead, optionally from a quote. totalPence is the campaign
// total (the sum of the lines); amountDuePence is what this invoice asks for:
// half the total for a deposit, the total less the paid deposits it deducts
// for a balance, the total for a full invoice. Due on receipt, or by dueDate.
model Invoice {
  id     String @id @default(cuid())
  // "INV-1106", from the INVOICE sequence.
  number String @unique

  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  // The quote it came from, if any. Deleting a draft quote keeps the invoice.
  quoteId  String?
  quote    Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  business Business

  type         InvoiceType
  status       InvoiceStatus @default(DRAFT)
  issueDate    DateTime      @db.Date
  dueOnReceipt Boolean       @default(false)
  // Set unless the invoice is due on receipt.
  dueDate      DateTime?     @db.Date

  // The client as printed on the invoice.
  clientName         String
  clientBusinessName String?
  clientEmail        String?
  clientAddress      String?
  targetAreas        String?

  totalPence     Int
  amountDuePence Int
  notes          String?

  // The day the payment was received.
  paidAt   DateTime? @db.Date
  sentAt   DateTime?
  voidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines      InvoiceLine[]
  // On a balance invoice: the deposits it deducts.
  deductions InvoiceDeduction[] @relation("BalanceInvoice")
  // On a deposit invoice: the balance invoices that deduct it.
  deductedBy InvoiceDeduction[] @relation("DepositInvoice")

  @@index([leadId])
  @@index([quoteId])
  @@index([status])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  label       String
  quantity    Int?
  amountPence Int
  sortOrder   Int

  @@index([invoiceId])
}

// A paid deposit deducted on a balance invoice. amountPence is the deposit as
// it was deducted, so the balance invoice reads the same later. Deleting a
// draft balance invoice removes its rows; a deposit that has been deducted
// can't be deleted.
model InvoiceDeduction {
  balanceInvoiceId String
  balanceInvoice   Invoice @relation("BalanceInvoice", fields: [balanceInvoiceId], references: [id], onDelete: Cascade)
  depositInvoiceId String
  depositInvoice   Invoice @relation("DepositInvoice", fields: [depositInvoiceId], references: [id], onDelete: Restrict)

  amountPence Int

  @@id([balanceInvoiceId, depositInvoiceId])
  @@index([depositInvoiceId])
}
