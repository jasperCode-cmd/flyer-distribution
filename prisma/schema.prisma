generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Only "admin" is used today. Plain string (not an enum) so a future
// role like "guest" can be introduced without a schema migration.
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  // Short login handle, used instead of email to sign in. Nullable so the
  // column could be added to a table that already had rows; every real
  // account is expected to have one, and a row without one cannot log in.
  username           String?  @unique
  passwordHash       String
  name               String
  role               String   @default("admin")
  // Forces a password change (enforced server-side via middleware) before
  // the account can use the rest of the CRM. True for newly seeded users.
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  assignedLeads    Lead[]            @relation("AssignedLeads")
  activities       Activity[]
  savedFilterViews SavedFilterView[]
}

enum LeadSource {
  WEBSITE_QUOTE_FORM
  INSTAGRAM_DM
  REFERRAL
  COLD_OUTREACH
  OTHER
}

enum PipelineStage {
  UNCONTACTED
  AWAITING_RESPONSE
  WON
  LOST
}

enum LostReason {
  PRICE
  CHOSE_COMPETITOR
  WENT_QUIET
  NOT_READY
  OTHER
}

enum LeadPriority {
  HIGH
  MEDIUM
  LOW
}

model Lead {
  id           String  @id @default(cuid())
  name         String
  phone        String?
  email        String?
  // Required going forward for leads entered manually in the CRM. Nullable
  // here because leads auto-captured from the public /quote form have no
  // postcode field to source it from (removed from that form deliberately;
  // see project notes) — enforced as required in the manual Add Lead form
  // instead of at the database level.
  postcode     String?
  businessName String?
  addressArea  String?

  dealValue        Decimal? @db.Decimal(10, 2)
  leafletQuantity  String?
  targetAreas      String?
  printingIncluded Boolean  @default(false)
  designIncluded   Boolean  @default(false)

  source   LeadSource    @default(OTHER)
  stage    PipelineStage @default(UNCONTACTED)
  priority LeadPriority  @default(MEDIUM)
  // Usable within "Awaiting Response" for a stalled/hesitant lead.
  atRisk Boolean @default(false)

  // Prompted for when a lead is moved to the Lost stage. lostReasonNote
  // carries the free text when lostReason is OTHER.
  lostReason     LostReason?
  lostReasonNote String?

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  job        Job?
  tasks      Task[]
  tags       LeadTag[]

  @@index([stage])
  @@index([assignedToId])
  @@index([priority])
}

enum ActivityType {
  CALL
  EMAIL
  NOTE
  STAGE_CHANGE
}

// "Last interacted" is derived at query time (most recent Activity per
// Lead), not stored as a redundant column.
model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  detail    String
  createdAt DateTime     @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt])
}

// Follow-up tasks for a lead, separate from the auto-detected "stale lead"
// signal (which is based on last Activity, not a scheduled follow-up).
model Task {
  id          String   @id @default(cuid())
  description String
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([dueDate])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#2563eb")

  leads LeadTag[]
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

// A user's saved combination of table/Kanban filters, for quick re-selection.
// Kept as a JSON blob rather than individual columns so new filter fields
// (e.g. tags added later) don't require a schema change here.
model SavedFilterView {
  id      String @id @default(cuid())
  name    String
  filters Json

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum JobStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Job {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  printStatus  WorkStatus @default(NOT_STARTED)
  designStatus WorkStatus @default(NOT_STARTED)
  // Plain text for now; structured so a real Distributor table could
  // reference it later without reshaping this field.
  distributorName String?

  campaignStartDate DateTime?
  completionDate    DateTime?

  // Nullable foundation for a future real map integration — not populated
  // or read by any external mapping API today.
  latitude  Float?
  longitude Float?

  // Matches the business's actual current tracking method (Strava route
  // screenshots), not GPS hardware, which isn't live yet.
  deliveryConfirmed Boolean @default(false)
  deliveryProofNote String?

  status JobStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
