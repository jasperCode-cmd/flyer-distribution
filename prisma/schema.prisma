generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Only "admin" is used today. Plain string (not an enum) so a future
// role like "guest" can be introduced without a schema migration.
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  // Short login handle, used instead of email to sign in. Nullable so the
  // column could be added to a table that already had rows; every real
  // account is expected to have one, and a row without one cannot log in.
  username           String?  @unique
  passwordHash       String
  name               String
  role               String   @default("admin")
  // Forces a password change (enforced server-side via middleware) before
  // the account can use the rest of the CRM. True for newly seeded users.
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  assignedLeads    Lead[]            @relation("AssignedLeads")
  activities       Activity[]
  savedFilterViews SavedFilterView[]
  calendarEvents   CalendarEvent[]
}

enum LeadSource {
  WEBSITE_QUOTE_FORM
  INSTAGRAM_DM
  REFERRAL
  COLD_OUTREACH
  // Gathered face-to-face — canvassing, events, trade shows. Distinct from
  // a scraped cold-outreach list and from a referral.
  MET_IN_PERSON
  OTHER
}

enum PipelineStage {
  UNCONTACTED
  AWAITING_RESPONSE
  WON
  LOST
}

enum LostReason {
  PRICE
  CHOSE_COMPETITOR
  WENT_QUIET
  NOT_READY
  OTHER
}

enum LeadPriority {
  HIGH
  MEDIUM
  LOW
}

// Both of the below are only meaningful once a lead is Won, but they carry a
// default on every lead so the columns can be NOT NULL and no row needs
// special handling.
enum ReviewStatus {
  NOT_REQUESTED
  REQUESTED
  RECEIVED
}

enum PaymentStatus {
  NOT_PAID
  DEPOSIT_PAID
  PARTIAL_PAID
  PAID_IN_FULL
}

model Lead {
  id           String  @id @default(cuid())
  name         String
  phone        String?
  email        String?
  // Required going forward for leads entered manually in the CRM. Nullable
  // here because leads auto-captured from the public /quote form have no
  // postcode field to source it from (removed from that form deliberately;
  // see project notes) — enforced as required in the manual Add Lead form
  // instead of at the database level.
  postcode     String?
  businessName String?
  addressArea  String?

  dealValue        Decimal? @db.Decimal(10, 2)
  leafletQuantity  String?
  targetAreas      String?
  printingIncluded Boolean  @default(false)
  designIncluded   Boolean  @default(false)

  source   LeadSource    @default(OTHER)
  stage    PipelineStage @default(UNCONTACTED)
  priority LeadPriority  @default(MEDIUM)
  // Usable within "Awaiting Response" for a stalled/hesitant lead.
  atRisk   Boolean       @default(false)

  // Prompted for when a lead is moved to the Lost stage. lostReasonNote
  // carries the free text when lostReason is OTHER.
  lostReason     LostReason?
  lostReasonNote String?

  // Surfaced on the Won stage. amountPaid mirrors dealValue's precision so
  // the two can be compared without rounding surprises; it stays nullable
  // because a lead with no quoted value has nothing to auto-fill from.
  reviewStatus  ReviewStatus  @default(NOT_REQUESTED)
  paymentStatus PaymentStatus @default(NOT_PAID)
  amountPaid    Decimal?      @db.Decimal(10, 2)

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities     Activity[]
  job            Job?
  tasks          Task[]
  tags           LeadTag[]
  calendarEvents CalendarEvent[]

  @@index([stage])
  @@index([assignedToId])
  @@index([priority])
}

enum ActivityType {
  CALL
  EMAIL
  NOTE
  STAGE_CHANGE
}

// "Last interacted" is derived at query time (most recent Activity per
// Lead), not stored as a redundant column.
model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  detail    String
  createdAt DateTime     @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt])
}

// Follow-up tasks for a lead, separate from the auto-detected "stale lead"
// signal (which is based on last Activity, not a scheduled follow-up).
model Task {
  id          String   @id @default(cuid())
  description String
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([dueDate])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#2563eb")

  leads LeadTag[]
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

// A user's saved combination of table/Kanban filters, for quick re-selection.
// Kept as a JSON blob rather than individual columns so new filter fields
// (e.g. tags added later) don't require a schema change here.
model SavedFilterView {
  id      String @id @default(cuid())
  name    String
  filters Json

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum JobStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Job {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  printStatus     WorkStatus   @default(NOT_STARTED)
  designStatus    WorkStatus   @default(NOT_STARTED)
  // Plain text for now; structured so a real Distributor table could
  // reference it later without reshaping this field.
  distributorName String?
  // Structured link to a real Distributor. Deliberately kept alongside
  // distributorName rather than replacing it — existing free-text values
  // are NOT auto-matched to Distributor rows; that stays a manual step.
  distributorId   String?
  distributor     Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  campaignStartDate DateTime?
  completionDate    DateTime?

  // Nullable foundation for a future real map integration — not populated
  // or read by any external mapping API today.
  latitude  Float?
  longitude Float?

  // Matches the business's actual current tracking method (Strava route
  // screenshots), not GPS hardware, which isn't live yet.
  deliveryConfirmed Boolean @default(false)
  deliveryProofNote String?

  status JobStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEvents CalendarEvent[]

  @@index([distributorId])
}

// A person or subcontractor who delivers leaflets. Deactivated via the
// active flag rather than deleted, so past Jobs and CalendarEvents keep
// pointing at a real row.
model Distributor {
  id     String  @id @default(cuid())
  name   String
  phone  String?
  email  String?
  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs           Job[]
  calendarEvents CalendarEvent[]

  @@index([active])
}

enum CalendarEventType {
  CALL
  COLD_CALL_BLOCK
  DISTRIBUTOR_SHIFT
  GENERAL
}

// Manually created calendar entries. Job dates and Task due dates are
// surfaced on the calendar too, but are read from their own models at
// query time rather than duplicated as rows here.
model CalendarEvent {
  id            String            @id @default(cuid())
  type          CalendarEventType
  title         String
  startDateTime DateTime
  // Null for a point-in-time entry; set for a multi-hour or multi-day one.
  endDateTime   DateTime?
  notes         String?
  completed     Boolean           @default(false)

  // All four links are optional and set null on delete, so removing a
  // lead, job, user, or distributor never silently deletes a calendar
  // entry someone scheduled.
  linkedLeadId String?
  linkedLead   Lead?   @relation(fields: [linkedLeadId], references: [id], onDelete: SetNull)

  linkedJobId String?
  linkedJob   Job?    @relation(fields: [linkedJobId], references: [id], onDelete: SetNull)

  assignedToUserId String?
  assignedToUser   User?   @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // Only meaningful for DISTRIBUTOR_SHIFT entries.
  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDateTime])
  @@index([type])
  @@index([assignedToUserId])
  @@index([distributorId])
  @@index([linkedLeadId])
  @@index([linkedJobId])
}
